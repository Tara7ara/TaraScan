{
  "swagger": "2.0",
  "openapi": "3.0.0",
  "info": {
    "title": "Lab API",
    "version": "1.0.0",
    "description": "API de ejemplo del laboratorio de TaraScan"
  },
  "basePath": "/api/v1",
  "paths": {
    "/users": {
      "get": {
        "summary": "Lista usuarios",
        "responses": {"200": {"description": "ok"}}
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Detalle de usuario",
        "parameters": [{"name": "id", "in": "path", "required": true, "type": "integer"}],
        "responses": {"200": {"description": "ok"}}
      }
    },
    "/admin/secrets": {
      "get": {
        "summary": "Secretos (sin auth, a propósito)",
        "responses": {"200": {"description": "ok"}}
      }
    }
  }
}
